---
// 定义组件接受的属性，可以根据需要进行扩展
const { 
  leftColumnClass = "",
  rightColumnClass = "",
  reverseOnMobile = false
} = Astro.props;
---
<div class={`two-column-container ${reverseOnMobile ? 'reverse-mobile' : ''}`}>
  <div class={`left-column ${leftColumnClass}`}>
    <slot name="left" />
  </div>
  <div class={`right-column ${rightColumnClass}`}>
    <slot name="right" />
  </div>
</div>
<style>
  .two-column-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    margin: 2rem 0;
  }
  
  /* 移动端左列padding */
  .left-column {
    padding: 0 1rem; /* 上下1rem，左右1.5rem，你可以根据需要调整 */
  }
  
  /* 右侧列水平居中 + 添加padding */
  .right-column {
    display: flex;
    flex-direction: column;
    /* align-items: flex-start; 左对齐 */
    align-items: center;
    padding: 0 1rem 1rem 1rem; /* 上0.5rem，右1rem，下1rem，左1rem，你可以根据需要调整 */
  }
  
  /* 默认手机端显示顺序 */
  .reverse-mobile {
    flex-direction: column-reverse;
  }
  
  /* 桌面端样式 */
  @media (min-width: 768px) {
    .two-column-container {
      flex-direction: row;
      align-items: flex-start;
    }
    .left-column, .right-column {
      flex: 1;
    }
    .left-column {
      padding-right: 0 1.5rem; /* 这里你的原代码有个问题，应该是 padding: 0 1.5rem 0 0; */
      padding: 0 1.5rem 0 0; /* 桌面端左列：右侧1.5rem padding */
    }
    .right-column {
      padding: 0 0 0 1.5rem; /* 桌面端右列：左侧1.5rem padding */
    }
    /* 即使在移动端设置了反转，在桌面端也恢复正常顺序 */
    .reverse-mobile {
      flex-direction: row;
    }
  }
</style>