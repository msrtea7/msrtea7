            this.durationEl = container.querySelector('.duration');

            this.isDragging = false;
            this.icons = ICONS;
            this.init();
        }

        init() {
            const src = this.audio.dataset.src;
            this.audio.src = src;

            // 设置初始图标
            this.playBtn.innerHTML = this.icons.play;
            this.backwardBtn.innerHTML = this.icons.backward;
            this.forwardBtn.innerHTML = this.icons.forward;

            this.playBtn.addEventListener('click', () => this.togglePlay());
            this.backwardBtn.addEventListener('click', () => this.skip(-5));
            this.forwardBtn.addEventListener('click', () => this.skip(5));
            this.progressBar.addEventListener('click', (e) => this.seek(e));
            
            // 拖拽功能
            this.progressHandle.addEventListener('mousedown', (e) => this.startDrag(e));
            this.progressHandle.addEventListener('touchstart', (e) => this.startDrag(e));
            document.addEventListener('mousemove', (e) => this.drag(e));
            document.addEventListener('touchmove', (e) => this.drag(e));
            document.addEventListener('mouseup', () => this.endDrag());
            document.addEventListener('touchend', () => this.endDrag());

            this.audio.addEventListener('loadedmetadata', () => this.updateDuration());
            this.audio.addEventListener('timeupdate', () => this.updateProgress());
            this.audio.addEventListener('ended', () => this.onEnded());
            this.audio.addEventListener('error', (e) => this.onError(e));
            this.audio.addEventListener('loadstart', () => this.onLoadStart());
            this.audio.addEventListener('canplay', () => this.onCanPlay());

            // 键盘事件
            document.addEventListener('keydown', (e) => this.handleKeydown(e));
        }

        togglePlay() {
            if (this.audio.paused) {
                this.audio.play();
                this.playBtn.innerHTML = this.icons.pause;
            } else {
                this.audio.pause();
                this.playBtn.innerHTML = this.icons.play;
            }
        }

        skip(seconds) {
            this.audio.currentTime += seconds;
        }

        seek(e) {
            if (this.isDragging) return;
            if (!this.audio.duration) return;
            
            const rect = this.progressBar.getBoundingClientRect();
            const percent = (e.clientX - rect.left) / rect.width;
            const newTime = percent * this.audio.duration;
            
            if (!isNaN(newTime) && isFinite(newTime)) {
                this.audio.currentTime = newTime;
            }
        }

        startDrag(e) {
            this.isDragging = true;
            this.progressHandle.classList.add('dragging');
            this.updateProgressFromEvent(e);
            e.preventDefault();
        }

        drag(e) {
            if (!this.isDragging) return;
            this.updateProgressFromEvent(e);
            e.preventDefault();
        }

        endDrag() {
            this.isDragging = false;
            this.progressHandle.classList.remove('dragging');
        }

        updateProgressFromEvent(e) {
            if (!this.audio.duration) return;
            
            const rect = this.progressBar.getBoundingClientRect();
            const clientX = e.clientX || (e.touches && e.touches[0].clientX);
            const percent = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
            const newTime = percent * this.audio.duration;
            
            if (!isNaN(newTime) && isFinite(newTime)) {
                this.audio.currentTime = newTime;
            }
        }

        updateProgress() {
            if (this.isDragging) return;
            if (!this.audio.duration) return;
            
            const percent = (this.audio.currentTime / this.audio.duration) * 100;
            if (!isNaN(percent) && isFinite(percent)) {
                this.progressFill.style.width = `${percent}%`;
                this.progressHandle.style.left = `${percent}%`;
                this.currentTimeEl.textContent = this.formatTime(this.audio.currentTime);
            }
        }

        updateDuration() {
            this.durationEl.textContent = this.formatTime(this.audio.duration);
        }

        formatTime(seconds) {
            if (isNaN(seconds)) return '0:00';
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${mins}:${secs.toString().padStart(2, '0')}`;
        }

        onEnded() {
            this.playBtn.innerHTML = this.icons.play;
            this.audio.currentTime = 0;
        }

        onError(e) {
            console.error('音频加载失败:', e);
            this.container.style.opacity = '0.5';
        }

        onLoadStart() {
            console.log('开始加载音频');
        }

        onCanPlay() {
            console.log('音频可以开始播放');
        }

        handleKeydown(e) {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
                return;
            }

            if (e.code === 'Space') {
                e.preventDefault();
                this.togglePlay();
            }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.audio-player').forEach(player => {
            new SimpleAudio(player);
        });
    });
</script>