---
// AudioPlayer.astro
interface Props {
    src: string;
}

const { src } = Astro.props;
---

<div class="audio-player">
    <audio preload="metadata" data-src={src}></audio>
    
    <div class="progress-container">
        <span class="current-time">0:00</span>
        <div class="progress-bar">
            <div class="progress-fill"></div>
            <div class="progress-handle">
                <img src="/audioPlayer_icon/dot.svg" alt="进度控制点">
            </div>
        </div>
        <span class="duration">0:00</span>
    </div>
    
    <div class="controls">
        <button class="skip-btn backward-btn">-5s</button>
        <button class="play-btn">▶</button>
        <button class="skip-btn forward-btn">+5s</button>
    </div>
</div>

<style>
    .audio-player {
        border-top: 1px dotted #CDC7BC;
        border-bottom: 1px dotted #CDC7BC;
        padding: 1.5rem;
        background-color: #F8EDDA;
        max-width: 400px;
        width: 100%;
        margin: 1rem auto;
    }



    .progress-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .progress-bar {
        flex: 1;
        height: 0.15rem;
        background: rgba(205, 199, 188, 0.3);
        border-radius: 0.125rem;
        cursor: pointer;
        position: relative;
    }

    .progress-fill {
        height: 100%;
        background: #e6a788;
        border-radius: 0.125rem;
        width: 0%;
        transition: width 0.1s ease;
    }

    .progress-handle {
        position: absolute;
        top: 50%;
        left: 0%;
        transform: translate(-50%, -50%);
        cursor: grab;
        transition: left 0.1s ease;
    }

    .progress-handle:active {
        cursor: grabbing;
    }

    .progress-handle img {
        width: 0.5rem;
        height: 0.5rem;
        pointer-events: none;
        display: block;
        transform-origin: center center;
        transition: transform 0.2s ease;
    }

    .progress-handle:hover img,
    .progress-handle.dragging img {
        transform: scale(1.3);
    }

    .current-time,
    .duration {
        font-size: 0.75rem;
        color: #777;
        min-width: 2.5rem;
        text-align: center;
    }

    .controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
    }

    .controls button {
        border: none;
        background: transparent;
        color: #777;
        cursor: pointer;
        font-weight: 600;
        transition: transform 0.1s ease;
        padding: 0;
    }

    .controls button:hover {
        transform: scale(1.05);
    }

    .play-btn {
        width: 1.5rem;
        height: 1.5rem;
        font-size: 1.2rem;
    }

    .skip-btn {
        width: 1.15rem;
        height: 1.15rem;
        font-size: 0.7rem;
    }

    .controls img {
        width: 1.25rem;
        height: 1.25rem;
        pointer-events: none;
    }

    .play-btn img {
        width: 1.5rem;
        height: 1.5rem;
    }
</style>

<script>
    class SimpleAudio {
        constructor(container) {
            this.container = container;
            this.audio = container.querySelector('audio');
            this.playBtn = container.querySelector('.play-btn');
            this.backwardBtn = container.querySelector('.backward-btn');
            this.forwardBtn = container.querySelector('.forward-btn');
            this.progressBar = container.querySelector('.progress-bar');
            this.progressFill = container.querySelector('.progress-fill');
            this.progressHandle = container.querySelector('.progress-handle');
            this.currentTimeEl = container.querySelector('.current-time');
            this.durationEl = container.querySelector('.duration');

            this.isDragging = false;
            this.init();
        }

        init() {
            const src = this.audio.dataset.src;
            this.audio.src = src;

            // 设置初始图标
            this.playBtn.innerHTML = '<img src="/audioPlayer_icon/play.svg" alt="播放">';
            this.backwardBtn.innerHTML = '<img src="/audioPlayer_icon/back.svg" alt="后退5秒">';
            this.forwardBtn.innerHTML = '<img src="/audioPlayer_icon/forward.svg" alt="前进5秒">';

            this.playBtn.addEventListener('click', () => this.togglePlay());
            this.backwardBtn.addEventListener('click', () => this.skip(-5));
            this.forwardBtn.addEventListener('click', () => this.skip(5));
            this.progressBar.addEventListener('click', (e) => this.seek(e));
            
            // 拖拽功能
            this.progressHandle.addEventListener('mousedown', (e) => this.startDrag(e));
            this.progressHandle.addEventListener('touchstart', (e) => this.startDrag(e));
            document.addEventListener('mousemove', (e) => this.drag(e));
            document.addEventListener('touchmove', (e) => this.drag(e));
            document.addEventListener('mouseup', () => this.endDrag());
            document.addEventListener('touchend', () => this.endDrag());

            this.audio.addEventListener('loadedmetadata', () => this.updateDuration());
            this.audio.addEventListener('timeupdate', () => this.updateProgress());
            this.audio.addEventListener('ended', () => this.onEnded());
            this.audio.addEventListener('error', (e) => this.onError(e));
            this.audio.addEventListener('loadstart', () => this.onLoadStart());
            this.audio.addEventListener('canplay', () => this.onCanPlay());
        }

        togglePlay() {
            if (this.audio.paused) {
                this.audio.play();
                this.playBtn.innerHTML = '<img src="/audioPlayer_icon/stop.svg" alt="暂停">';
            } else {
                this.audio.pause();
                this.playBtn.innerHTML = '<img src="/audioPlayer_icon/play.svg" alt="播放">';
            }
        }

        skip(seconds) {
            this.audio.currentTime += seconds;
        }

        seek(e) {
            if (this.isDragging) return; // 避免与拖拽冲突
            if (!this.audio.duration) return; // 如果音频还没加载完成，直接返回
            
            const rect = this.progressBar.getBoundingClientRect();
            const percent = (e.clientX - rect.left) / rect.width;
            const newTime = percent * this.audio.duration;
            
            // 检查新时间是否有效
            if (!isNaN(newTime) && isFinite(newTime)) {
                this.audio.currentTime = newTime;
            }
        }

        startDrag(e) {
            this.isDragging = true;
            this.progressHandle.classList.add('dragging');
            this.updateProgressFromEvent(e);
            e.preventDefault();
        }

        drag(e) {
            if (!this.isDragging) return;
            this.updateProgressFromEvent(e);
            e.preventDefault();
        }

        endDrag() {
            this.isDragging = false;
            this.progressHandle.classList.remove('dragging');
        }

        updateProgressFromEvent(e) {
            if (!this.audio.duration) return; // 如果音频还没加载完成，直接返回
            
            const rect = this.progressBar.getBoundingClientRect();
            const clientX = e.clientX || (e.touches && e.touches[0].clientX);
            const percent = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
            const newTime = percent * this.audio.duration;
            
            // 检查新时间是否有效
            if (!isNaN(newTime) && isFinite(newTime)) {
                this.audio.currentTime = newTime;
            }
        }

        updateProgress() {
            if (this.isDragging) return;
            if (!this.audio.duration) return; // 防止除零错误
            
            const percent = (this.audio.currentTime / this.audio.duration) * 100;
            if (!isNaN(percent) && isFinite(percent)) {
                this.progressFill.style.width = `${percent}%`;
                this.progressHandle.style.left = `${percent}%`;
                this.currentTimeEl.textContent = this.formatTime(this.audio.currentTime);
            }
        }

        updateDuration() {
            this.durationEl.textContent = this.formatTime(this.audio.duration);
        }

        formatTime(seconds) {
            if (isNaN(seconds)) return '0:00';
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${mins}:${secs.toString().padStart(2, '0')}`;
        }

        onEnded() {
            this.playBtn.innerHTML = '<img src="/audioPlayer_icon/play.svg" alt="播放">';
            this.audio.currentTime = 0;
        }

        onError(e) {
            console.error('音频加载失败:', e);
            this.container.style.opacity = '0.5';
        }

        onLoadStart() {
            console.log('开始加载音频');
        }

        onCanPlay() {
            console.log('音频可以开始播放');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.audio-player').forEach(player => {
            new SimpleAudio(player);
        });
    });
</script>