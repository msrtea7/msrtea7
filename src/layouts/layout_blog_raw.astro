---
// src/layouts/Layout.astro
// 主题文件（必需）
import '../styles/themes/colors-light.css';
import '../styles/themes/colors-dark.css';

// 设计系统（必需）
import '../styles/tokens/design-system.css';

// 组件样式（按需导入）
import '../styles/tokens/responsive.css';
import '../styles/components/article.css';
import '../styles/components/article_complement.css';
import '../styles/components/navigation.css';
import '../styles/components/carousel.css';
import '../styles/components/copy-button.css';
import '../styles/components/audio-player.css';
import '../styles/components/cv.css';
// import '../styles/components/agave.css';


// import '../styles/components/code-theme.css';


// 注意！这里不要import别的了，会产生冲突，神奇。我也不想管了

import Navigation from '../components/Nav_home.astro';

const { title } = Astro.props;
---

<html lang="zh">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
        .layout {
            margin: 0 auto; /*使整个布局容器在页面中水平居中。 */
            width: 100%; /*让布局容器占据其父元素的全部可用宽度。*/
            max-width: 1200px;
            padding: 1rem; /*在布局容器的内部添加了一个 2rem 的内边距，需要在主css里面设置盒修正*/
        }
    </style>
    <!-- Google tag (gtag.js) -->
    <script is:inline type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-4S7GYQ56PX"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-4S7GYQ56PX");
    </script>
</head>

<body>
    <div class="layout">
        <Navigation />
        <slot />

        <script src="../components/js/copy-code.js"></script>
    </div>
</body>
</html>