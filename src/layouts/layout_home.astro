---
const { title } = Astro.props;
// 主题文件（必需）
import '../styles/themes/colors-light.css';
import '../styles/themes/colors-dark.css';

// 设计系统（必需）
import '../styles/tokens/design-system.css';


// 组件样式（按需导入）
import '../styles/tokens/responsive.css';
// import '../styles/components/article.css';
// import '../styles/components/article_complement.css';
import '../styles/components/blog-card.css';
import '../styles/components/carousel.css';
import '../styles/components/home-styles.css';
import '../styles/components/navigation.css';
import '../styles/components/social-media.css';

import Navigation from '../components/Nav_home.astro';
// import GoogleAnalytics from '../components/google_analytics.astro';

---

<html lang="zh">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <style>
      .layout {
        margin: 0 auto; /*使整个布局容器在页面中水平居中。 */
        width: 100%; /*让布局容器占据其父元素的全部可用宽度。*/
        max-width: 1200px;
        padding: 1rem; /*在布局容器的内部添加了一个 2rem 的内边距，需要在主css里面设置盒修正*/
      }
    </style>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Google tag (gtag.js) -->
    <script is:inline type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-4S7GYQ56PX"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-4S7GYQ56PX");
    </script>
  </head>
  <body>
    <div class="layout">
      <Navigation />
      <slot />
    </div>
  </body>
</html>