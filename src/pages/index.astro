---
import { Image } from 'astro:assets';
import IMG_portrait from '../assets/home/a.png';
import MainLayout from '../layouts/layout_home.astro';

// import Navigation from '../components/Nav_home.astro';
import TwoColumn from '../components/2column.astro';
import SocialMedia from '../components/socialMedia.astro';



const pageTitle = "msrtea7";
---
    
<MainLayout title={pageTitle}>
    <!-- <Navigation /> -->
    <TwoColumn>
        <div slot="left">
            <h1 class="title-size">你好，</h1>
            <br>
            <div class="normal-size">
                <!-- 我叫雷达、李黁、Walbaacco，字德钗，代号msrtea7。<br> -->
                我叫雷达，代号msrtea7。<br>
                02年生，肖马，男的，浙江人。<br>
                <!-- 我喜欢抽红利群，红塔山。<br> -->
                钟爱蹲坑，抗拒马桶垫子。<br>
                不长胡子，用的米诺地尔。<br>
                聊天很难，见面好。<br>
            </div>
            <SocialMedia />
            <div class="normal-size-2">
                <span class="red-text">公告：</span>近期 Site themes(paticularly the dark theme) are now under intensive re-write and re-design. 为可能造成不舒服的浏览体验表示歉意，会尽快完成更新。
            </div>
        </div>
        <div slot="right">
            <Image 
            src={IMG_portrait} 
            alt="Me, portrait" 
            class="portrait-image" 
            />
            
            <!-- <ImageGrid 
            images={[
                {src: IMG_portrait, alt: "作品1描述"},
                {src: IMG_portrait, alt: "作品2描述"},
                {src: IMG_portrait, alt: "作品3描述"},
                {src: IMG_portrait, alt: "作品4描述"}
            ]}
            /> -->

            
        </div>

    </TwoColumn>
</MainLayout>

<style>
    .title-size {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 1rem;
    }
    
    .normal-size {
        font-size: 1.125rem;
        line-height: 1.6;
    }

    .normal-size_2 {
        font-size: 1rem;
        line-height: 1.6;
    }
</style>